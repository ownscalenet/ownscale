{
  "name": "ownscale-e2e-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playwright end-to-end tests for the ownscale frontend, run against a real `make dev-up` stack. Kept as its own package (not part of frontend/) so Playwright and its browser binaries never weigh down the production `make frontend` build. See ../README.md.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:connectivity": "playwright test --config playwright.connectivity.config.ts",
    "test:connectivity:contract": "playwright test --config playwright.connectivity-contract.config.ts",
    "test:ssh": "playwright test --config playwright.ssh.config.ts",
    "test:serve": "playwright test --config playwright.serve.config.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "json-rpc-2.0": "^1.8.1",
    "typescript": "~7.0.2"
  }
}
