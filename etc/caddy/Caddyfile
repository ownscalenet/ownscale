{
	# Ask the admin panel before issuing a certificate for a subdomain.
	on_demand_tls {
		ask http://ownscale:8080/api/tls-ask
	}

	# Set CADDY_LOCAL_CERTS=local_certs in .env whenever BASE_DOMAIN isn't a
	# publicly-resolvable domain (e.g. "os.test", or any local dev domain
	# under a reserved/non-public TLD -- see RFC 2606). This makes Caddy
	# issue every certificate (including on-demand ones) from its own
	# internal CA instead of attempting real ACME issuance via Let's
	# Encrypt, which always fails for such domains ("Domain name does not
	# end with a valid public suffix (TLD)"). Leave unset in production, so
	# Caddy gets real, publicly-trusted certificates via ACME as usual.
	{$CADDY_LOCAL_CERTS:}

	# Set CADDY_LOG_LEVEL=debug in docker-compose.yaml to get verbose
	# debug-level logs from Caddy.
	log {
		level {$CADDY_LOG_LEVEL:INFO}
	}
}

{$BASE_DOMAIN} {
	reverse_proxy ownscale:8080
}

docs.{$BASE_DOMAIN} {
	tls {
		on_demand
	}
	root * /srv/site
	file_server
}

# Local-dev OIDC provider (dexidp/dex, see docker-compose.yml) that
# ownscale federates its own login to (see internal/auth,
# auth.upstream_oidc.issuer in config.yaml). Exposing it through Caddy
# under its own subdomain means the browser-facing authorization endpoint
# and ownscale's server-to-server discovery/token/userinfo calls all hit
# the same HTTPS origin, so no split browser-vs-backend endpoint config is
# needed -- and it reuses the same local-CA trust story as every other
# subdomain here.
dex.{$BASE_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy dex:5556
}


# Route https://<sub>.{$BASE_DOMAIN} to the hs-<sub> container, and
# https://<sub>.{$BASE_DOMAIN}/admin to the hp-<sub> (headplane) container.
*.{$BASE_DOMAIN} {
	tls {
		on_demand
	}

    map {host} {backend} {
           ~^([a-z0-9-]+)\. "hs-${1}:8080"
    }

    map {host} {hpbackend} {
           ~^([a-z0-9-]+)\. "hp-${1}:3000"
    }

    handle /admin* {
           reverse_proxy {hpbackend}
    }

    handle {
           reverse_proxy {backend}
    }
}
