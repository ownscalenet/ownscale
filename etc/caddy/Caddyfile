{
	# Selects which DNS-01 provider solves the ACME challenge for the
	# *.{$BASE_DOMAIN} wildcard cert. See providers directory for required
	# credential env vars. "none" is for local dev.
	import /etc/caddy/providers/{$DNS_PROVIDER:none}.caddyfile

	# Local-dev options (local_certs, local CA). Only present when
	# compose.dev.yaml mounts etc/caddy/dev; an unmatched glob is a no-op.
	import /etc/caddy/dev/global*.caddyfile

	# Set CADDY_LOG_LEVEL=debug in .env to get verbose
	# debug-level logs from Caddy.
	log {
		level {$CADDY_LOG_LEVEL:INFO}
	}

	# Drop slow-header and idle clients. No read/write timeouts: tailnet
	# long-polls and funnel WebSockets stay open.
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# The Ownscale console (web UI, API, its own OIDC provider) is at
# console.{$BASE_DOMAIN}; everything else goes to ownscale below.
console.{$BASE_DOMAIN} {
	reverse_proxy ownscale:8080
}

# Local-dev sites (Dex), see the global import above.
import /etc/caddy/dev/sites*.caddyfile

# The docs site and the content domain's landing page. CONTENT_DOMAIN defaults
# to BASE_DOMAIN (see compose.yaml); a repeated address is fine.
{$BASE_DOMAIN}, {$CONTENT_DOMAIN} {
	reverse_proxy ownscale:8080
}

# Route https://<sub>.{$BASE_DOMAIN} (org headscale) and
# https://<label>-<sub>.{$CONTENT_DOMAIN} (funnels) to the ownscale container.
*.{$BASE_DOMAIN}, *.{$CONTENT_DOMAIN} {
	reverse_proxy ownscale:8080 {
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
