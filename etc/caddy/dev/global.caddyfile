# Local-dev global options, imported by the Caddyfile only when
# compose.dev.yaml mounts this directory.

# BASE_DOMAIN (e.g. "ownscale.test") isn't publicly resolvable, so ACME
# can't issue certs for it; issue every cert from the internal CA instead.
local_certs

# Sign local certs from the root CA pre-generated by compose.dev.yaml's
# "local-ca-init" service, so ownscale and its headscale
# instances can trust it via a plain static mount.
pki {
	ca local {
		root {
			cert /etc/ownscale-local-ca/root.crt
			key /etc/ownscale-local-ca/root.key
		}
	}
}
