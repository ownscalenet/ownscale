# Copy to .env and fill in real values.
# docker-compose reads BASE_DOMAIN once here and passes it into both the
# ownscale service (as OWNSCALE_BASE_DOMAIN) and the caddy service (used in
# etc/caddy/Caddyfile), so the wildcard domain only needs to be set in one
# place.
#
# For local dev, "ownscale.test" (an RFC 2606-reserved TLD, so it'll never
# collide with a real public domain) is the default -- see
# etc/dex/config.yaml, which hardcodes that same domain (Dex's own config
# loader doesn't support env var interpolation, unlike this file). It needs
# an /etc/hosts entry per subdomain actually used (this one,
# "dex.ownscale.test", "console.ownscale.test", and one per organization
# created) since "*.ownscale.test" has no real wildcard DNS -- see
# README.md. Pair with CADDY_LOCAL_CERTS=local_certs below.
BASE_DOMAIN=example.com

# Address the HTTP server listens on.
OWNSCALE_ADDR=:8080

# All databases (ownscale, headscale instances) will be collected into this dir.
# It must be absolute, so set to the result of running "echo $PWD/data".
OWNSCALE_DATA_DIR=/opt/ownscale/data

# For easier development on local, caddy uses self-signed certificates with a
# CA that ownscale also trusts (via SSL_CERT_DIR). "osa gen-local-ca" is
# the command that generates it. Relative to OWNSCALE_DATA_DIR unless absolute.
OWNSCALE_LOCAL_CA_DIR=local-ca

# ownscale/litestream containers run as HOST_UID:HOST_GID (default 0:0, i.e.
# root, if unset) so bind-mounted files under OWNSCALE_DATA_DIR are owned by
# a real user instead of root. `make dev-up` sets these automatically to
# your own uid/gid; for a bare `docker compose up` deployment (no make),
# set them explicitly here to whatever user should own OWNSCALE_DATA_DIR on
# this host.
# HOST_UID=1000
# HOST_GID=1000

# Random string used to sign the login session cookie. Required to run the server.
OWNSCALE_AUTH_SESSION_SECRET=changeme

# Upstream OIDC provider ownscale itself logs in against, used for
# discovery and as the standard OIDC relying party.
# Put "https://dex.ownscale.test" if you're using local deployment. Leave
# client id empty to skip this.
OWNSCALE_AUTH_UPSTREAM_OIDC_ISSUER=
OWNSCALE_AUTH_UPSTREAM_OIDC_CLIENT_ID=
OWNSCALE_AUTH_UPSTREAM_OIDC_CLIENT_SECRET=
OWNSCALE_AUTH_UPSTREAM_OIDC_CALLBACK_URL=https://console.ownscale.test/auth/oidc/callback

# Optional: enables a direct "Sign in with Google" button on the login page
# (in addition to the "Sign in with SSO" button above, which is backed by
# OWNSCALE_AUTH_UPSTREAM_OIDC_* and could itself point at Google's OIDC
# issuer). Leave client id empty to skip this. To create an
# OAuth 2.0 client ID: https://console.cloud.google.com/apis/credentials.
OWNSCALE_AUTH_GOOGLE_CLIENT_ID=
OWNSCALE_AUTH_GOOGLE_CLIENT_SECRET=
OWNSCALE_AUTH_GOOGLE_CALLBACK_URL=https://console.ownscale.test/auth/google/callback

# Optional: enables a direct "Sign in with Microsoft" button on the login
# page (multi-tenant: works with both personal Microsoft accounts and
# work/school Azure AD accounts). Register an app at
# https://portal.azure.com (Azure Active Directory > App registrations) to
# get a client id; it's shown directly on the app's Overview page. Leave
# client id empty to skip this.
OWNSCALE_AUTH_MICROSOFT_CLIENT_ID=
OWNSCALE_AUTH_MICROSOFT_CLIENT_SECRET=
OWNSCALE_AUTH_MICROSOFT_CALLBACK_URL=https://console.ownscale.test/auth/microsoft/callback

# OIDC provider configuration: ownscale itself acts as an OpenID Connect
# provider (federated to OWNSCALE_AUTH_UPSTREAM_OIDC_* above) that each
# organization's headscale instance trusts for SSO. See auth/oidcprovider.
# Issuer defaults to "https://console.${OWNSCALE_BASE_DOMAIN}" if unset
# (ownscale itself is bound to the "console" subdomain).
OWNSCALE_AUTH_OIDC_PROVIDER_ISSUER=
# Path to the RSA private key used to sign issued ID tokens (relative to
# OWNSCALE_DATA_DIR unless absolute). Auto-generated on first startup if
# missing.
OWNSCALE_AUTH_OIDC_PROVIDER_SIGNING_KEY_PATH=oidc_signing_key.pem
# Lifetimes of issued OAuth access/OIDC ID tokens (Go duration strings).
OWNSCALE_AUTH_OIDC_PROVIDER_ACCESS_TOKEN_LIFETIME=5m
OWNSCALE_AUTH_OIDC_PROVIDER_ID_TOKEN_LIFETIME=1h

# Minimum level to log: "debug", "info", "warn", or "error". Defaults to "info".
OWNSCALE_LOG_LEVEL=info
# Log output encoding: "json" or "text". Defaults to "json".
OWNSCALE_LOG_FORMAT=json

# DERP relay used by every organization's headscale instance.
# Optional: leave hostname empty (the default) to keep using Tailscale's
# public DERP map, unchanged.
# Public DNS name of the DERP relay (matches deploy/derper's DERP_HOSTNAME),
# e.g. "derp.ownscale.net". Required to enable this feature.
OWNSCALE_DERP_HOSTNAME=
# Public IPv4/IPv6 address of the DERP relay. Recommended so clients don't
# need to rely on DNS to reach it, but not required.
OWNSCALE_DERP_IPV4=
OWNSCALE_DERP_IPV6=
# UDP port the relay's STUN server listens on. Defaults to 3478.
OWNSCALE_DERP_STUN_PORT=3478
# Arbitrary identifiers for this custom DERP region in headscale's DERP
# map. Defaults shown below; only matter if you're also using a custom
# derp-map file of your own outside of ownscale's management.
OWNSCALE_DERP_REGION_ID=900
OWNSCALE_DERP_REGION_CODE=custom
OWNSCALE_DERP_REGION_NAME=Ownscale DERP

# Set to "debug" for verbose Caddy logs.
CADDY_LOG_LEVEL=info

# Optional: host IP address to bind Caddy's published ports; defaults to 0.0.0.0.
CADDY_LISTEN_IP=

# Set to "local_certs" for local dev when BASE_DOMAIN isn't a publicly
# resolvable domain (e.g. "ownscale.test"): makes Caddy issue every
# certificate from its own internal CA -- signed from a pre-generated local
# development root CA (see the "local-ca-init" service in
# docker-compose.yml and localca)
CADDY_LOCAL_CERTS=

# Set to "true" to disable HTTP caches everywhere.
OWNSCALE_DEVELOPMENT=

# Azure DNS credentials (a service principal with "DNS Zone Contributor"
# on the zone), used by Caddy's "dns azure" global option (see
# etc/caddy/Caddyfile) to complete the ACME DNS-01 challenge for the
# *.{$BASE_DOMAIN} wildcard certificate in real deployments. Leave all blank for
# local dev, where CADDY_LOCAL_CERTS above makes Caddy use its own internal CA
# instead and these are never used.
# TODO: if ownscale is for a wider audience to use, having it locked to just
# azure is not ideal.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Continuously replicates every SQLite database under ${PWD}/data
# (this app's own db plus every organization's headscale db) to a remote
# destination, using litestream's directory watcher feature.
# LITESTREAM_REPLICA_URL=abs://ownscale@litestream/backup
# LITESTREAM_REPLICA_URL=file:///home/gabriel/Code/ownscale/data/backup
LITESTREAM_REPLICA_URL=s3://my-backup-bucket/ownscale

# Credentials for the replica destination. Read automatically by
# litestream (not written into any config file). Leave blank to fall back
# to the standard AWS credential chain (e.g. an instance/task IAM role).
# Only used for S3/S3-compatible replicas.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Leave blank for AWS S3. Set both to point at an S3-compatible backend.
LITESTREAM_REGION=
LITESTREAM_ENDPOINT=

LITESTREAM_AZURE_ACCOUNT_KEY=

# How often litestream syncs local changes to the replica.
LITESTREAM_SYNC_INTERVAL=10s
