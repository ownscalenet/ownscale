# Copy to .env and fill in real values.
# docker-compose reads BASE_DOMAIN once here and passes it into both the
# ownscale service (as OWNSCALE_BASE_DOMAIN, overriding config.yaml's
# base_domain) and the caddy service (used in etc/caddy/Caddyfile), so the
# wildcard domain only needs to be set in one place.
#
# For local dev, "ownscale.test" (an RFC 2606-reserved TLD, so it'll never
# collide with a real public domain) is the default -- see config.yaml and
# etc/dex/config.yaml, which hardcode that same domain (Dex's own config
# loader doesn't support env var interpolation, unlike this file). Unlike
# the previous "lvh.me"-based setup, this needs an /etc/hosts entry per
# subdomain actually used (this one, "dex.ownscale.test",
# "docs.ownscale.test", and one per organization created) since
# "*.ownscale.test" has no real wildcard DNS -- see README.md. Pair with
# CADDY_LOCAL_CERTS=local_certs below.
BASE_DOMAIN=example.com

# All databases (ownscale, headscale instances) will be collected into this dir.
# It must be absolute, so set to the result of running "echo $PWD/data".
OWNSCALE_DATA_DIR=/opt/ownscale/data

# Set to "debug" for verbose Caddy logs.
CADDY_LOG_LEVEL=info

# Optional: host IP address to bind Caddy's published ports; defaults to 0.0.0.0.
CADDY_LISTEN_IP=

# Set to "local_certs" for local dev when BASE_DOMAIN isn't a publicly
# resolvable domain (e.g. "ownscale.test"): makes Caddy issue every
# certificate from its own internal CA -- signed from a pre-generated local
# development root CA (see the "local-ca-init" service in
# docker-compose.yml and localca)
CADDY_LOCAL_CERTS=

# Azure DNS credentials (a service principal with "DNS Zone Contributor"
# on the zone), used by Caddy's "dns azure" global option (see
# etc/caddy/Caddyfile) to complete the ACME DNS-01 challenge for the
# *.{$BASE_DOMAIN} wildcard certificate in real deployments. Leave all blank for
# local dev, where CADDY_LOCAL_CERTS above makes Caddy use its own internal CA
# instead and these are never used.
# TODO: if ownscale is for a wider audience to use, having it locked to just
# azure is not ideal.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Continuously replicates every SQLite database under ${PWD}/data
# (this app's own db plus every organization's headscale db) to a remote
# destination, using litestream's directory watcher feature.
# LITESTREAM_REPLICA_URL=abs://ownscale@litestream/backup
# LITESTREAM_REPLICA_URL=file:///home/gabriel/Code/ownscale/data/backup
LITESTREAM_REPLICA_URL=s3://my-backup-bucket/ownscale

# Credentials for the replica destination. Read automatically by
# litestream (not written into any config file). Leave blank to fall back
# to the standard AWS credential chain (e.g. an instance/task IAM role).
# Only used for S3/S3-compatible replicas.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Leave blank for AWS S3. Set both to point at an S3-compatible backend.
LITESTREAM_REGION=
LITESTREAM_ENDPOINT=

LITESTREAM_AZURE_ACCOUNT_KEY=

# How often litestream syncs local changes to the replica.
LITESTREAM_SYNC_INTERVAL=10s
