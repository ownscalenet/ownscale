# ownscale configuration. Copy this file to .env next to compose.yaml, set the
# required settings, then run `docker compose up -d`.
#
# How to read this file:
# - Settings without a leading "#" are the ones you need to set or review.
# - Commented "# NAME=value" lines show the built-in default. Uncomment a line
#   only to change it.

# ============================================================================
# Required
# ============================================================================

# Domain you control, with a wildcard DNS record (*.example.com) pointing at
# this server. The console is served at console.<BASE_DOMAIN>, each
# organization's login server at <org>.<BASE_DOMAIN>, and the documentation at
# the bare domain.
BASE_DOMAIN=example.com

# Random secret that signs console session cookies. Generate one with:
#   openssl rand -hex 32
# Changing it signs everyone out of the console.
OWNSCALE_AUTH_SESSION_SECRET=

# DNS provider that hosts the zones of BASE_DOMAIN and CONTENT_DOMAIN. Caddy
# uses it for ACME DNS-01 wildcard certificates, and ownscale for machine
# certificates (`tailscale cert`, `tailscale serve`). Required in production.
# One of: azure, cloudflare, hetzner, rfc2136. Set its credentials below.
# "none" (the default) is only for local development: Caddy then issues
# certificates from a local CA and machine certificates are disabled.
DNS_PROVIDER=

# ----------------------------------------------------------------------------
# DNS provider credentials: fill in the block for your DNS_PROVIDER.
# ----------------------------------------------------------------------------

# Cloudflare: an API token with Zone:Read and DNS:Edit on the zones.
CLOUDFLARE_API_TOKEN=

# Hetzner DNS: an API token.
HETZNER_API_TOKEN=

# Azure DNS: a service principal with "DNS Zone Contributor" on the zones.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# RFC 2136 dynamic updates to your own DNS server (BIND, Knot, PowerDNS, ...).
# The TSIG key must be allowed to update TXT records in the zones.
# RFC2136_SERVER is host:port (e.g. ns1.example.com:53), RFC2136_KEY the
# base64 TSIG secret.
RFC2136_SERVER=
RFC2136_KEY_NAME=
RFC2136_KEY=
# RFC2136_KEY_ALG=hmac-sha256

# ============================================================================
# Recommended
# ============================================================================

# Release of the ownscale images to run, e.g. v0.1.0. Pin it so upgrades only
# happen when you change it.
# OWNSCALE_VERSION=latest

# Host directory for ownscale persisted data (ownscale's database plus one per
# organization) and generated keys, mounted at /data in the container. A
# relative path is resolved against the folder holding compose.yaml.
# OWNSCALE_DATA_DIR=./data

# Separate domain for user content: funnels at
# https://<label>-<org>.<CONTENT_DOMAIN> and machine names (certificates) at
# <machine>.<random tailnet label>.os.<CONTENT_DOMAIN>. Use a separate
# registrable domain (e.g. example-content.net, not content.example.com), so
# content published by users can't set cookies on or make requests as the
# console. Needs its own wildcard DNS record, managed by DNS_PROVIDER.
# Defaults to BASE_DOMAIN.
# CONTENT_DOMAIN=

# ----------------------------------------------------------------------------
# Login providers. Passkeys always work; each provider below adds a sign-in
# button when its client ID is set. Anyone who can sign in can create an
# organization, so for a private instance prefer an OIDC provider that only
# admits your users.
#
# Register ownscale with each provider using its callback (redirect) URL:
#   https://console.<BASE_DOMAIN>/auth/<oidc|google|microsoft|github>/callback
# The *_CALLBACK_URL settings default to exactly that; only set them if your
# console is reached under a different URL.
# ----------------------------------------------------------------------------

# "Sign in with SSO": any OpenID Connect provider (Okta, Keycloak, Authentik,
# Dex, Google Workspace, Entra ID, ...). The issuer is the URL that serves
# /.well-known/openid-configuration.
OWNSCALE_AUTH_UPSTREAM_OIDC_ISSUER=
OWNSCALE_AUTH_UPSTREAM_OIDC_CLIENT_ID=
OWNSCALE_AUTH_UPSTREAM_OIDC_CLIENT_SECRET=
# OWNSCALE_AUTH_UPSTREAM_OIDC_CALLBACK_URL=https://console.<BASE_DOMAIN>/auth/oidc/callback

# "Sign in with Google". Create an OAuth client ID at
# https://console.cloud.google.com/apis/credentials.
OWNSCALE_AUTH_GOOGLE_CLIENT_ID=
OWNSCALE_AUTH_GOOGLE_CLIENT_SECRET=
# OWNSCALE_AUTH_GOOGLE_CALLBACK_URL=https://console.<BASE_DOMAIN>/auth/google/callback

# "Sign in with Microsoft" (personal and work/school accounts). Register an
# app in Microsoft Entra ID (https://portal.azure.com > App registrations).
OWNSCALE_AUTH_MICROSOFT_CLIENT_ID=
OWNSCALE_AUTH_MICROSOFT_CLIENT_SECRET=
# OWNSCALE_AUTH_MICROSOFT_CALLBACK_URL=https://console.<BASE_DOMAIN>/auth/microsoft/callback

# "Sign in with GitHub". Register an OAuth app at
# https://github.com/settings/developers.
OWNSCALE_AUTH_GITHUB_CLIENT_ID=
OWNSCALE_AUTH_GITHUB_CLIENT_SECRET=
# OWNSCALE_AUTH_GITHUB_CALLBACK_URL=https://console.<BASE_DOMAIN>/auth/github/callback

# ----------------------------------------------------------------------------
# Backups. ownscale continuously replicates every database with Litestream.
# Leave OWNSCALE_BACKUP_REPLICA_URL empty to disable backups. Restore with
# `osa restore db` then `osa restore organizations`.
# ----------------------------------------------------------------------------

# Where to replicate, one of:
#   s3://my-bucket/ownscale                AWS S3 or an S3-compatible service
#   abs://<account>@<container>/ownscale   Azure Blob Storage
#   file:///backups/ownscale               a local path (use another disk)
OWNSCALE_BACKUP_REPLICA_URL=

# S3 credentials. Leave empty to use the standard AWS credential chain (e.g.
# an instance role).
OWNSCALE_BACKUP_ACCESS_KEY_ID=
OWNSCALE_BACKUP_SECRET_ACCESS_KEY=
# For S3-compatible services (MinIO, R2, B2, ...), set both. ENDPOINT is also
# used for Azure Blob Storage.
# OWNSCALE_BACKUP_REGION=
# OWNSCALE_BACKUP_ENDPOINT=
# Azure Blob Storage account key, for abs:// replicas.
# OWNSCALE_BACKUP_AZURE_ACCOUNT_KEY=
# How often changes are pushed to the replica. Changes made since the last
# push are lost if the server dies.
# OWNSCALE_BACKUP_SYNC_INTERVAL=10s

# ============================================================================
# Optional: the defaults suit most installations.
# ============================================================================

# Funnel limits. The rate and concurrency limits apply to all funnels of an
# organization together, so one organization can't exhaust the server.
# Visitors over a limit get an error page (413, 429 or 503). Every value
# must be positive.
# Largest request body, in bytes (32 MiB).
# FUNNEL_MAX_BODY_BYTES=33554432
# Sustained requests per second, and how many more may arrive in a burst.
# FUNNEL_RATE_PER_SECOND=100
# FUNNEL_RATE_BURST=200
# Requests being proxied at the same time.
# FUNNEL_MAX_CONCURRENT=256

# Zone DNS_PROVIDER writes machine-certificate challenges into. Only set it
# when CONTENT_DOMAIN is a subdomain of the zone. Defaults to CONTENT_DOMAIN.
# Machine certificates come from Let's Encrypt: names appear in public
# Certificate Transparency logs, and all organizations share its limit of 50
# new certificates per registered domain per week.
# DNS_ZONE=
# How long to wait for a challenge record to reach public resolvers before
# asking the CA to check it. 0 skips waiting.
# DNS_PROPAGATION_TIMEOUT=2m

# DERP relay map, fetched every 3h and pushed to every organization. To use
# your own relay (see deploy/derper), serve a map listing it and set its URL.
# OWNSCALE_DERP_MAP_URL=https://controlplane.tailscale.com/derpmap/default

# ownscale is itself the OpenID Connect provider every organization's
# Headscale trusts for sign-in. These rarely need changing.
# OWNSCALE_AUTH_OIDC_PROVIDER_ISSUER=https://console.<BASE_DOMAIN>
# RSA key signing ID tokens, relative to OWNSCALE_DATA_DIR; generated on first
# start. Keep it: replacing it invalidates issued tokens.
# OWNSCALE_AUTH_OIDC_PROVIDER_SIGNING_KEY_PATH=oidc_signing_key.pem
# OWNSCALE_AUTH_OIDC_PROVIDER_ACCESS_TOKEN_LIFETIME=5m
# OWNSCALE_AUTH_OIDC_PROVIDER_ID_TOKEN_LIFETIME=1h

# Logging: level is debug, info, warn or error; format is json or text.
# OWNSCALE_LOG_LEVEL=info
# OWNSCALE_LOG_FORMAT=json
# Caddy's log level; debug is verbose.
# CADDY_LOG_LEVEL=info

# Host IP that Caddy's ports (80, 443/tcp, 443/udp) are published on.
# CADDY_LISTEN_IP=0.0.0.0

# Debug server with pprof and memory stats. Off when empty; must be a loopback
# address, e.g. 127.0.0.1:6060.
# OWNSCALE_DEBUG_ADDR=

# "true" disables HTTP caching everywhere. Development only.
# OWNSCALE_DEVELOPMENT=
