# Copy example.env to .env and fill in real values. For local development, also
# uncomment the block at the end of this file.
#
# docker compose reads BASE_DOMAIN once here and passes it into both the
# ownscale service (as OWNSCALE_BASE_DOMAIN) and the caddy service (used in
# etc/caddy/Caddyfile), so the wildcard domain only needs to be set in one
# place.
BASE_DOMAIN=example.com

# Optional domain for funnels, served as https://<label>-<org>.<FUNNEL_DOMAIN>.
# Defaults to BASE_DOMAIN. Recommended: a separate registrable domain (e.g.
# example-funnel.net, not funnel.example.com), so public funnel content can't
# CSRF or set cookies on the console. Needs its own wildcard DNS record, and
# DNS_PROVIDER must manage its zone too.
FUNNEL_DOMAIN=

# Max request body size proxied to a funnel, in bytes. Defaults to 32 MiB.
FUNNEL_MAX_BODY_BYTES=33554432

# Address the HTTP server listens on.
OWNSCALE_ADDR=:8080

# All databases (ownscale, headscale instances) will be collected into this dir.
# It must be absolute, so set to the result of running "echo $PWD/data".
OWNSCALE_DATA_DIR=/opt/ownscale/data

# Random string used to sign the login session cookie. Required to run the server.
OWNSCALE_AUTH_SESSION_SECRET=changeme

# Upstream OIDC provider ownscale itself logs in against, used for
# discovery and as the standard OIDC relying party.
# Leave client id empty to skip this.
OWNSCALE_AUTH_UPSTREAM_OIDC_ISSUER=
OWNSCALE_AUTH_UPSTREAM_OIDC_CLIENT_ID=
OWNSCALE_AUTH_UPSTREAM_OIDC_CLIENT_SECRET=
OWNSCALE_AUTH_UPSTREAM_OIDC_CALLBACK_URL=https://console.example.com/auth/oidc/callback

# Optional: enables a direct "Sign in with Google" button on the login page
# (in addition to the "Sign in with SSO" button above, which is backed by
# OWNSCALE_AUTH_UPSTREAM_OIDC_* and could itself point at Google's OIDC
# issuer). Leave client id empty to skip this. To create an
# OAuth 2.0 client ID: https://console.cloud.google.com/apis/credentials.
OWNSCALE_AUTH_GOOGLE_CLIENT_ID=
OWNSCALE_AUTH_GOOGLE_CLIENT_SECRET=
OWNSCALE_AUTH_GOOGLE_CALLBACK_URL=https://console.example.com/auth/google/callback

# Optional: enables a direct "Sign in with Microsoft" button on the login
# page. Register an app at
# https://portal.azure.com (Azure Active Directory > App registrations) to
# get a client id. Leave client id empty to skip this.
OWNSCALE_AUTH_MICROSOFT_CLIENT_ID=
OWNSCALE_AUTH_MICROSOFT_CLIENT_SECRET=
OWNSCALE_AUTH_MICROSOFT_CALLBACK_URL=https://console.example.com/auth/microsoft/callback

# OIDC provider configuration: ownscale itself acts as an OpenID Connect
# provider (federated to OWNSCALE_AUTH_UPSTREAM_OIDC_* above) that each
# organization's headscale instance trusts for SSO. See auth/oidcprovider.
# Issuer defaults to "https://console.${OWNSCALE_BASE_DOMAIN}" if unset
# (ownscale itself is bound to the "console" subdomain).
OWNSCALE_AUTH_OIDC_PROVIDER_ISSUER=
# Path to the RSA private key used to sign issued ID tokens (relative to
# OWNSCALE_DATA_DIR unless absolute). Auto-generated on first startup if
# missing.
OWNSCALE_AUTH_OIDC_PROVIDER_SIGNING_KEY_PATH=oidc_signing_key.pem
# Lifetimes of issued OAuth access/OIDC ID tokens (Go duration strings).
OWNSCALE_AUTH_OIDC_PROVIDER_ACCESS_TOKEN_LIFETIME=5m
OWNSCALE_AUTH_OIDC_PROVIDER_ID_TOKEN_LIFETIME=1h

# Minimum level to log: "debug", "info", "warn", or "error". Defaults to "info".
OWNSCALE_LOG_LEVEL=info
# Log output encoding: "json" or "text". Defaults to "json".
OWNSCALE_LOG_FORMAT=json

# Optional debug server (pprof, runtime memory stats). Off when empty.
# Must bind a loopback IP, e.g. 127.0.0.1:6060.
OWNSCALE_DEBUG_ADDR=

# DERP map ownscale fetches every 3h and hands to every headscale instance.
# To use a self-hosted relay (deploy/derper), serve a DERP map listing it.
OWNSCALE_DERP_MAP_URL=https://controlplane.tailscale.com/derpmap/default

# Set to "debug" for verbose Caddy logs.
CADDY_LOG_LEVEL=info

# Optional: host IP address to bind Caddy's published ports; defaults to 0.0.0.0.
CADDY_LISTEN_IP=

# Set to "true" to disable HTTP caches everywhere.
OWNSCALE_DEVELOPMENT=

# Which DNS-01 provider Caddy uses to complete the ACME challenge for the
# *.{$BASE_DOMAIN} and *.{$FUNNEL_DOMAIN} wildcard certificates. Required in production.
# One of: azure, cloudflare, route53, hetzner, digitalocean, none.
# None is for local dev, where Caddy issues certs from the local CA instead.
DNS_PROVIDER=

# Azure DNS credentials (a service principal with "DNS Zone Contributor"
# on the zone). Used when DNS_PROVIDER=azure.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Cloudflare API token (Zone:Read + DNS:Edit on the zone). Used when
# DNS_PROVIDER=cloudflare.
CLOUDFLARE_API_TOKEN=

# AWS credentials for Route53 (IAM permissions: ListHostedZones*,
# GetChange, ChangeResourceRecordSets on the zone). Used when
# DNS_PROVIDER=route53. Leave blank to fall back to the standard AWS
# credential chain (e.g. an instance/task IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Hetzner DNS API token. Used when DNS_PROVIDER=hetzner.
HETZNER_API_TOKEN=

# DigitalOcean API token (scoped to DNS). Used when DNS_PROVIDER=digitalocean.
DIGITALOCEAN_API_TOKEN=

# Litestream replication settings.
# Ownscale continuously replicates its own SQLite database as well as the
# databases created by headscale instances to a remote destination.
# Leave empty to disable replication and backups.
# OWNSCALE_BACKUP_REPLICA_URL=file:///opt/ownscale/data/.backups
# OWNSCALE_BACKUP_REPLICA_URL=abs://ownscale@container/backup
# OWNSCALE_BACKUP_REPLICA_URL=s3://my-backup-bucket/ownscale

# Credentials for S3/S3-compatible replicas. Leave blank to fall back to the
# standard AWS credential chain (e.g. an instance/task IAM role).
OWNSCALE_BACKUP_ACCESS_KEY_ID=
OWNSCALE_BACKUP_SECRET_ACCESS_KEY=

# Leave blank for AWS S3. Set both to point at an S3-compatible backend.
# OWNSCALE_BACKUP_ENDPOINT is also used for Azure Blob Storage replicas.
OWNSCALE_BACKUP_REGION=
OWNSCALE_BACKUP_ENDPOINT=

# Account key for Azure Blob Storage (abs://) replicas.
OWNSCALE_BACKUP_AZURE_ACCOUNT_KEY=

# How often local changes are pushed to the replica.
OWNSCALE_BACKUP_SYNC_INTERVAL=10s

# --- Local development (uncomment) ---
# Layers compose.dev.yaml on top of compose.yaml. These lines
# come last, so they override the values above. "ownscale.test" is used by
# etc/dex/config.yaml.
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
# BASE_DOMAIN=ownscale.test
# FUNNEL_DOMAIN=
# OWNSCALE_DATA_DIR=/absolute/path/to/repo/data
# OWNSCALE_DEVELOPMENT=true
# DNS_PROVIDER=none
# CADDY_LISTEN_IP=127.0.0.1
# CADDY_LOG_LEVEL=debug
# OWNSCALE_LOG_FORMAT=text
# OWNSCALE_AUTH_SESSION_SECRET=dev-session-secret
# OWNSCALE_AUTH_UPSTREAM_OIDC_ISSUER=https://dex.ownscale.test
# OWNSCALE_AUTH_UPSTREAM_OIDC_CLIENT_ID=ownscale
# OWNSCALE_AUTH_UPSTREAM_OIDC_CLIENT_SECRET=ownscale-dev-secret
# OWNSCALE_AUTH_UPSTREAM_OIDC_CALLBACK_URL=https://console.ownscale.test/auth/oidc/callback
# OWNSCALE_AUTH_GOOGLE_CALLBACK_URL=https://console.ownscale.test/auth/google/callback
# OWNSCALE_AUTH_MICROSOFT_CALLBACK_URL=https://console.ownscale.test/auth/microsoft/callback
