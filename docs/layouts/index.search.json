{{- /* Fixed-path JSON search index (/search-index.json), fetched client-side
   by content/search.md. Scoped the same way as the hugo-book theme's own
   (fingerprinted) search-data.json, which this replaces. */ -}}
[
{{- $pages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- $pages = where $pages "Params.bookSearchExclude" "!=" true -}}
{{- $pages = where $pages "Content" "!=" "" -}}
{{- range $index, $page := $pages -}}
  {{- if gt $index 0 }},{{ end }}
  {
    "id": {{ $index }},
    "href": {{ $page.RelPermalink | jsonify }},
    "title": {{ $page.Title | jsonify }},
    "section": {{ (or $page.Parent.Title $.Site.Title) | jsonify }},
    "content": {{ $page.Plain | jsonify }}
  }
{{- end -}}
]
