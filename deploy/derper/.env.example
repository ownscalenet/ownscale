# Public DNS name for this DERP server. Must have an A (and/or AAAA) record
# pointing at this host's public IP before starting derper, since
# --certmode=letsencrypt needs to complete an HTTP-01 challenge on port 80
# under this hostname.
DERP_HOSTNAME=derp.example.com

# Optional: contact email associated with the Let's Encrypt ACME account
# (recommended by Let's Encrypt for expiry/revocation notices; not required).
DERP_ACME_EMAIL=

# Optional: host IP address to bind the published ports, defaults to 0.0.0.0.
DERP_LISTEN_IP=
